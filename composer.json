{
  "authors": [
    {
      "email": "tomaschochola@tomaschochola.cz",
      "homepage": "https://github.com/tomaschochola",
      "name": "Tomáš Chochola",
      "role": "Author"
    }
  ],
  "autoload": {
    "psr-4": {
      "TomasChochola\\Tooling\\PhpCsFixer\\": "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "./tests"
    }
  },
  "config": {
    "allow-plugins": false,
    "audit": {
      "abandoned": "fail"
    },
    "platform-check": true,
    "process-timeout": 0,
    "sort-packages": true
  },
  "description": "tomaschochola/tooling-php-cs-fixer",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/tomaschochola"
    }
  ],
  "homepage": "https://github.com/tomaschochola/tooling-php-cs-fixer",
  "keywords": [
    "tomaschochola",
    "TomasChochola",
    "Tomas Chochola",
    "Tomáš Chochola",
    "tooling-php-cs-fixer"
  ],
  "license": "CC-BY-ND-4.0",
  "minimum-stability": "dev",
  "name": "tomaschochola/tooling-php-cs-fixer",
  "prefer-stable": true,
  "readme": "./README.md",
  "repositories": [
    {
      "no-api": true,
      "type": "git",
      "url": "https://github.com/tomaschochola/tooling-phpstan.git"
    }
  ],
  "require": {
    "friendsofphp/php-cs-fixer": "^3.92",
    "php": "^8.5.0"
  },
  "require-dev": {
    "ext-intl": "*",
    "ext-pcntl": "*",
    "ext-xdebug": "*",
    "ext-zip": "*",
    "phpunit/phpunit": "^12.5",
    "roave/security-advisories": "dev-latest",
    "tomaschochola/tooling-phpstan": "^1.0@dev"
  },
  "support": {
    "docs": "https://github.com/tomaschochola/tooling-php-cs-fixer",
    "email": "tomaschochola@tomaschochola.cz",
    "issues": "https://github.com/tomaschochola/tooling-php-cs-fixer/issues",
    "source": "https://github.com/tomaschochola/tooling-php-cs-fixer.git"
  },
  "type": "library"
}
